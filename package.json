{
  "name": "agentflowing",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source Cloudflare-native starter for building and monetizing AI agent SaaS products.",
  "keywords": [
    "ai-agent",
    "cloudflare-workers",
    "durable-objects",
    "saas-starter",
    "stripe",
    "workers-ai"
  ],
  "homepage": "https://agentflowing.app",
  "bugs": {
    "url": "https://github.com/moutsea/agentflowing/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moutsea/agentflowing.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev",
    "build": "vite build",
    "postbuild": "node scripts/sanitize-build.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply agentflowing-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply agentflowing-db --remote",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.90",
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@cloudflare/ai-chat": "^0.11.0",
    "@hono/zod-validator": "^0.9.1",
    "agents": "^0.22.0",
    "ai": "^7.0.87",
    "better-auth": "^1.7.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "i18next": "^26.4.1",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.18.3",
    "stripe": "^22.6.0",
    "tailwind-merge": "^3.4.0",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.0",
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.119.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.15.0"
}
